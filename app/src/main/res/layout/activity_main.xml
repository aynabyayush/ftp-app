<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- MAIN CONTENT -->
    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <!-- HEADER BAR WITH MENU BUTTON AND TITLE -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <!-- TOP LEFT MENU BUTTON -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/glass_input_bg"
                    android:contentDescription="@string/menu_cd"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu" />

                <!-- HEADER TITLE -->
                <TextView
                    android:id="@+id/tvMainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:letterSpacing="0.05"
                    android:text="@string/app_name"
                    android:textColor="#FF6600"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/orbitron_bold" />

                <!-- TOP RIGHT SYNC MONITOR BUTTON -->
                <ImageButton
                    android:id="@+id/btnHomeSyncProgress"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/glass_btn_progress_bg"
                    android:contentDescription="Realtime Sync Monitor"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh" />
            </RelativeLayout>

            <!-- SERVER CONFIGURATION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvServerCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/host_ftp_server"
                    android:textColor="#FF6600"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/orbitron_bold"
                    android:layout_marginBottom="16dp" />

                <CheckBox
                    android:id="@+id/chkAnonymous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/anonymous_access_mode"
                    android:textColor="#E0F7FF"
                    android:textSize="14sp"
                    android:buttonTint="#FF6600" />

                <EditText
                    android:id="@+id/etServerUser"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="@string/username_hint"
                    android:inputType="text"
                    android:autofillHints="username"
                    android:textColorHint="#6600F0FF"
                    android:textColor="#E0F7FF"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/etServerPass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    android:autofillHints="password"
                    android:textColorHint="#6600F0FF"
                    android:textColor="#E0F7FF"
                    android:textSize="15sp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="10dp" />

                <EditText
                    android:id="@+id/etSharedDir"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="@string/shared_dir_hint"
                    android:inputType="text"
                    android:autofillHints=""
                    android:textColorHint="#6600F0FF"
                    android:textColor="#E0F7FF"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginTop="10dp" />

                <Button
                    android:id="@+id/btnToggleServer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_btn_bg"
                    android:text="@string/initialize_server"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="18dp" />

                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/hologram_status_bg"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/status_stopped"
                    android:textColor="#00FF66"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="14dp" />
            </LinearLayout>

            <!-- CLIENT CONNECTION CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvClientCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ftp_client_link"
                    android:textColor="#FF6600"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:fontFamily="@font/orbitron_bold"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etClientIp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/glass_input_bg"
                    android:hint="@string/target_ip_hint"
                    android:inputType="text"
                    android:autofillHints=""
                    android:textColorHint="#6600F0FF"
                    android:textColor="#E0F7FF"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp" />

                <Button
                    android:id="@+id/btnConnectServer"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/glass_btn_bg"
                    android:text="@string/connect_explore_server"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="14dp" />

                <!-- SAVED SERVERS SECTION -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="SAVED FTP SERVERS"
                    android:textColor="#FF6600"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvNoSavedServers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="No saved servers yet. Connect to a server to save it automatically."
                    android:textColor="#80C5DE"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSavedServers"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    tools:listitem="@layout/item_saved_server" />
            </LinearLayout>

            <!-- FOOTER AUTHOR CREDIT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:text="@string/author_credit"
                android:textColor="#80C5DE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp" />

        </LinearLayout>
    </ScrollView>

    <!-- SIDE PANEL (DRAWER) -->
    <LinearLayout
        android:id="@+id/sideDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- DRAWER HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="@string/cyber_control"
            android:textColor="#FF6600"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#3300F0FF" />

        <!-- LOCAL FILE MANAGER ITEM -->
        <LinearLayout
            android:id="@+id/menuLocalFileManager"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="File Manager" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="Local File Manager"
                android:textColor="#E0F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- REALTIME BACKUP ITEM -->
        <LinearLayout
            android:id="@+id/menuBackup"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="Backup" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="Realtime Sync"
                android:textColor="#E0F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HISTORY ITEM -->
        <LinearLayout
            android:id="@+id/menuHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="@string/history"
                android:textColor="#E0F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SETTINGS ITEM -->
        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="@string/settings"
                android:textColor="#E0F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ABOUT ITEM -->
        <LinearLayout
            android:id="@+id/menuAbout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/about" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="@string/about"
                android:textColor="#E0F7FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SPACER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- SIDE PANEL FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/side_panel_author"
            android:textColor="#80C5DE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron_bold" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>