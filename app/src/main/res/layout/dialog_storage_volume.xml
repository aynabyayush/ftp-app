<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="SELECT STORAGE VOLUME"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.1"
            android:text="[ INTERNAL &amp; SECONDARY SD CARD ]"
            android:textColor="#80C5DE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStorageVolumesList"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        tools:listitem="@layout/item_saved_server" />

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseStorageVolumes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/glass_input_bg"
        android:text="@string/cancel"
        android:textColor="#80C5DE"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>