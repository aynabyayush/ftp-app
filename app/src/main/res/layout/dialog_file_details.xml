<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="ℹ FILE INFORMATION"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_input_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Name: file.txt"
            android:textColor="#E0F7FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Type: File"
            android:textColor="#80C5DE"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Size: 12.5 MB"
            android:textColor="#80C5DE"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Modified: 2026-10-09 14:30:00"
            android:textColor="#80C5DE"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDetailPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Path: /storage/emulated/0/Download"
            android:textColor="#80C5DE"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseDetails"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/glass_btn_bg"
        android:text="@string/close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>