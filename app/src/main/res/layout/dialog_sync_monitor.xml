<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="REALTIME SYNC MONITOR"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.1"
            android:text="[ AUTOMATED BACKGROUND SYNC METRICS ]"
            android:textColor="#80C5DE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- SYNC PROGRESS CARD -->
    <LinearLayout
        android:id="@+id/cardSyncProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_input_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvSyncServerAlias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active Sync: Home Server"
            android:textColor="#E0F7FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <ProgressBar
            android:id="@+id/pbSyncProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00F0FF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvSyncBytesText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="45.2 MB Synced"
                android:textColor="#80C5DE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSyncSpeedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0.0 MB/s"
                android:textColor="#00FF66"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvSyncRemainingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:text="0.0 MB Remaining to sync"
            android:textColor="#00F0FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoActiveSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="All synced! No pending transfers."
        android:textColor="#80C5DE"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseSyncMonitor"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/glass_btn_bg"
        android:text="@string/close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>