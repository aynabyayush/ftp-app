<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvOptionFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="file_name.ext"
                android:textColor="#00F0FF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.1"
                android:text="[ FILE ACTIONS ]"
                android:textColor="#80C5DE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 1: TRANSMIT TO FTP -->
        <LinearLayout
            android:id="@+id/optTransmitFtp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Transmit to FTP Server"
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 2: COPY TO -->
        <LinearLayout
            android:id="@+id/optCopyFile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Copy To..."
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 3: MOVE TO -->
        <LinearLayout
            android:id="@+id/optMoveFile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Move To..."
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 4: SHARE EXTERNAL -->
        <LinearLayout
            android:id="@+id/optShareExternal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Share to External App"
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 5: COMPRESS (ZIP) -->
        <LinearLayout
            android:id="@+id/optCompressZip"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Compress (Zip)"
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 6: FILE DETAILS -->
        <LinearLayout
            android:id="@+id/optFileDetails"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="File Details"
                android:textColor="#E0F7FF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- OPTION 7: DELETE FILE -->
        <LinearLayout
            android:id="@+id/optDeleteFile"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="Delete File"
                android:textColor="#FF007F"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CLOSE BUTTON -->
        <Button
            android:id="@+id/btnCloseFileOptions"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/glass_input_bg"
            android:text="@string/cancel"
            android:textColor="#80C5DE"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>