<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="DOWNLOADS"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- REALTIME ACTIVE ITEM CARD -->
    <LinearLayout
        android:id="@+id/cardActiveTransfer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_input_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvTransferFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Name"
            android:textColor="#E0F7FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <ProgressBar
            android:id="@+id/pbTransferProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#00F0FF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/tvTransferBytes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="0.0 MB / 0.0 MB (0%)"
                android:textColor="#80C5DE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTransferSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0.0 MB/s"
                android:textColor="#00FF66"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <Button
            android:id="@+id/btnCancelActiveTransfer"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/glass_input_bg"
            android:text="CANCEL TRANSFER"
            android:textColor="#FF007F"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoActiveTransfers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="No active real-time transfers."
        android:textColor="#80C5DE"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3300F0FF"
        android:layout_marginVertical="8dp" />

    <!-- QUEUED DOWNLOADS SECTION -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.05"
        android:text="QUEUED DOWNLOADS"
        android:textColor="#00F0FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvNoQueued"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="No queued downloads."
        android:textColor="#80C5DE"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQueuedDownloads"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="8dp"
        tools:listitem="@layout/item_queue_transfer" />

    <!-- DIVIDER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#3300F0FF"
        android:layout_marginVertical="8dp" />

    <!-- SESSION COMPLETED TRANSFERS SECTION -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.05"
        android:text="SESSION COMPLETED TRANSFERS"
        android:textColor="#00F0FF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvNoCompletedSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:text="No completed downloads in this session yet."
        android:textColor="#80C5DE"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSessionCompleted"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        tools:listitem="@layout/item_session_transfer" />

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseTransferDialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/glass_btn_bg"
        android:text="@string/close"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>