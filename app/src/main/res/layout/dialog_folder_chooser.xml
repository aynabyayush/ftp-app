<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvFolderChooserTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/folder_chooser_title"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- PATH BREADCRUMB & BACK BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_bg"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/btnFolderUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/glass_input_bg"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_up"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvFolderPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/shared_dir_default"
            android:textColor="#00F0FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="start"
            android:singleLine="true" />
    </LinearLayout>

    <!-- FOLDER RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolderList"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        tools:listitem="@layout/item_folder_entry" />

    <TextView
        android:id="@+id/tvFolderEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:text="@string/no_subfolders_found"
        android:textColor="#80C5DE"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnCancelFolder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/glass_input_bg"
            android:text="@string/cancel"
            android:textColor="#80C5DE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSelectThisFolder"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:background="@drawable/glass_btn_bg"
            android:text="@string/select_this_folder"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>