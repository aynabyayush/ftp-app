<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/containerVideoPlayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/layoutVideoTopActions"
            android:letterSpacing="0.05"
            android:text="Video Player"
            android:textColor="#00F0FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <LinearLayout
            android:id="@+id/layoutVideoTopActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAddSubtitles"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/glass_input_bg"
                android:contentDescription="Add Subtitles"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_subtitles"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnFullscreenVideo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/glass_input_bg"
                android:contentDescription="Fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen"
                android:layout_marginEnd="6dp" />

            <ImageButton
                android:id="@+id/btnCloseVideoPlayer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/glass_input_bg"
                android:contentDescription="Close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close" />
        </LinearLayout>
    </RelativeLayout>

    <!-- VIDEO DISPLAY FRAME WITH OVERLAY SUBTITLES -->
    <FrameLayout
        android:id="@+id/frameVideoDisplay"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/glass_card_bg"
        android:padding="2dp">

        <VideoView
            android:id="@+id/vvInbuiltVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvVideoSubtitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#A6000000"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- SEEKBAR & TIME STAMP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp">

        <SeekBar
            android:id="@+id/sbVideoProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressTint="#00F0FF"
            android:thumbTint="#00F0FF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/tvVideoCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00:00"
                android:textColor="#00F0FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVideoTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="00:00"
                android:textColor="#80C5DE"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- PLAYBACK CONTROL BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnRewind10"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/glass_input_bg"
            android:text="-10s"
            android:textColor="#E0F7FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp"
            android:layout_marginEnd="12dp" />

        <ImageButton
            android:id="@+id/btnPlayPauseVideo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/glass_btn_bg"
            android:contentDescription="Play/Pause"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pause"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btnForward10"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/glass_input_bg"
            android:text="+10s"
            android:textColor="#E0F7FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

</LinearLayout>