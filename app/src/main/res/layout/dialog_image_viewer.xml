<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- TOP BAR -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvImageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnCloseImageViewer"
            android:letterSpacing="0.05"
            android:text="Image Viewer"
            android:textColor="#00F0FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnCloseImageViewer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/glass_input_bg"
            android:contentDescription="Close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />
    </RelativeLayout>

    <!-- IMAGE FRAME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:background="@drawable/glass_card_bg"
        android:gravity="center"
        android:padding="4dp">

        <ImageView
            android:id="@+id/ivInbuiltImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="Image View"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- FOOTER INFO & SHARE ICON BUTTON -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tvImageDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="1080 x 1920 • 2.4 MB"
            android:textColor="#80C5DE"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnShareImage"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/glass_btn_secondary_bg"
            android:contentDescription="Share Image"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share" />
    </RelativeLayout>

</LinearLayout>