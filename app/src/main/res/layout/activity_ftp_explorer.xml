<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FtpExplorerActivity">

    <!-- MAIN CONTENT AREA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <!-- LEFT SIDE: MENU + BACK + REFRESH -->
            <LinearLayout
                android:id="@+id/layoutTopLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/glass_input_bg"
                    android:contentDescription="@string/menu_cd"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_menu" />

                <ImageButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_input_bg"
                    android:contentDescription="Refresh"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_refresh" />
            </LinearLayout>

            <!-- CENTER TITLE & SERVER ADDRESS -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FTP EXPLORER"
                    android:textColor="#00F0FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvServerAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="ftp://192.168.1.100:2221"
                    android:textColor="#80C5DE"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RIGHT SIDE: REALTIME DOWNLOADS / TRANSFERS SPEED + CLOSE -->
            <LinearLayout
                android:id="@+id/layoutTopRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnActiveTransfers"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_btn_progress_bg"
                    android:contentDescription="Downloads"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_down"
                    android:layout_marginEnd="6dp" />

                <ImageButton
                    android:id="@+id/btnClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/glass_input_bg"
                    android:contentDescription="@string/close_explorer"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close" />
            </LinearLayout>
        </RelativeLayout>

        <!-- PATH BREADCRUMB + VIEW TOGGLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card_bg"
            android:orientation="horizontal"
            android:padding="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/glass_input_bg"
                android:contentDescription="Back"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_up" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PATH: "
                android:textColor="#80C5DE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentPath"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="/"
                android:textColor="#00F0FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="start"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btnViewToggle"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/glass_input_bg"
                android:contentDescription="@string/app_name"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_grid_view" />
        </LinearLayout>

        <!-- LOADING / EMPTY INDICATOR -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00F0FF"
            android:visibility="gone"
            android:layout_marginVertical="24dp" />

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No files or folders found."
            android:textColor="#80C5DE"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginVertical="24dp" />

        <!-- FILE LIST RECYCLERVIEW -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFileList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_ftp_file" />

        <!-- BOTTOM ACTION BUTTON (UPLOAD TO CURRENT DIRECTORY) -->
        <Button
            android:id="@+id/btnUploadToCurrentDir"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/glass_btn_secondary_bg"
            android:text="UPLOAD FILE TO THIS FOLDER"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- SIDE DRAWER PANEL -->
    <LinearLayout
        android:id="@+id/sideDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/drawer_bg"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- DRAWER HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="FTP MENU"
            android:textColor="#00F0FF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- DIVIDER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#3300F0FF" />

        <!-- ITEM 1: REMOTE ROOT -->
        <LinearLayout
            android:id="@+id/menuExplorerRoot"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="Root" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="Remote Root"
                android:textColor="#E0F7FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ITEM 2: ACTIVE TRANSFERS -->
        <LinearLayout
            android:id="@+id/menuExplorerTransfers"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_arrow_down"
                android:contentDescription="Transfers" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="Downloads"
                android:textColor="#E0F7FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ITEM 3: HISTORY -->
        <LinearLayout
            android:id="@+id/menuExplorerHistory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                android:contentDescription="History" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="@string/history"
                android:textColor="#E0F7FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ITEM 4: SETTINGS -->

        <!-- ITEM 5: CLOSE / DISCONNECT -->
        <LinearLayout
            android:id="@+id/menuExplorerSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="@string/settings"
                android:textColor="#E0F7FF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuExplorerClose"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/drawer_item_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.05"
                android:text="Disconnect Explorer"
                android:textColor="#FF007F"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SPACER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- FOOTER CREDIT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="@string/side_panel_author"
            android:textColor="#80C5DE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron_bold" />
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>