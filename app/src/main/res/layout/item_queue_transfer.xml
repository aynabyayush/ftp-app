<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_input_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/tvQueueBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/hologram_status_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="⏳ QUEUED"
        android:textColor="#00F0FF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvQueueFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:text="file_name.pdf"
        android:textColor="#E0F7FF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:ellipsize="end"
        android:singleLine="true" />

    <ImageButton
        android:id="@+id/btnCancelQueued"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/glass_input_bg"
        android:contentDescription="Cancel Queued Item"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        android:layout_marginStart="6dp" />
</LinearLayout>