<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="SELECT FILE TO UPLOAD"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- PATH BREADCRUMB & BACK BUTTON -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_bg"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageButton
            android:id="@+id/btnLocalUp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/glass_input_bg"
            android:contentDescription="Up Directory"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_up"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvLocalPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="/storage/emulated/0"
            android:textColor="#00F0FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:ellipsize="start"
            android:singleLine="true" />
    </LinearLayout>

    <!-- FILE RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLocalFileList"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        tools:listitem="@layout/item_local_file" />

    <TextView
        android:id="@+id/tvLocalEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:text="No files found in this directory."
        android:textColor="#80C5DE"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- CANCEL BUTTON -->
    <Button
        android:id="@+id/btnCancelLocalPicker"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/glass_input_bg"
        android:text="@string/cancel"
        android:textColor="#80C5DE"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>