<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_input_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvServerStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/hologram_status_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="🟢 ONLINE"
        android:textColor="#00FF66"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSavedServerAlias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Home Server"
            android:textColor="#E0F7FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvSavedServerAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ftp://192.168.1.100:2221"
            android:textColor="#80C5DE"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnDeleteSavedServer"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/glass_input_bg"
        android:contentDescription="Remove Server"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_trash"
        android:layout_marginStart="8dp" />
</LinearLayout>