<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_input_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/ivLocalIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_file"
        android:contentDescription="File Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLocalFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="File Name"
            android:textColor="#E0F7FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvLocalFileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="12.5 MB"
            android:textColor="#80C5DE"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnLocalFileMore"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/glass_input_bg"
        android:contentDescription="More Options"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more_vert"
        android:layout_marginStart="6dp" />
</LinearLayout>