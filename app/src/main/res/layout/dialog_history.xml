<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/data_transfer_logs"
            android:textColor="#00F0FF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- FILTER BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="14dp">

        <Button
            android:id="@+id/btnFilterAll"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="0.8"
            android:background="@drawable/glass_btn_bg"
            android:text="@string/filter_all"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnFilterReceived"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.2"
            android:background="@drawable/glass_input_bg"
            android:text="@string/filter_received"
            android:textColor="#80C5DE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnFilterSent"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/glass_input_bg"
            android:text="@string/filter_sent"
            android:textColor="#80C5DE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="2dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnFilterConnections"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1.4"
            android:background="@drawable/glass_input_bg"
            android:text="@string/filter_connections"
            android:textColor="#80C5DE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="2dp" />
    </LinearLayout>

    <!-- EMPTY STATE -->
    <TextView
        android:id="@+id/tvHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="32dp"
        android:text="@string/no_history_recorded"
        android:textColor="#80C5DE"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- HISTORY RECYCLERVIEW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistoryList"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        tools:listitem="@layout/item_history_entry" />

    <!-- ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnClearHistory"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/glass_input_bg"
            android:text="@string/clear_logs"
            android:textColor="#FF007F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnCloseHistory"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/glass_btn_bg"
            android:text="@string/close"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingHorizontal="12dp" />
    </LinearLayout>

</LinearLayout>