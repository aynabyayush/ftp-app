<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/drawer_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvFtpItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="folder_name"
            android:textColor="#00F0FF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.1"
            android:text="[ REMOTE SERVER ACTIONS ]"
            android:textColor="#80C5DE"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- OPTION 1: REMOTE RENAME -->
    <LinearLayout
        android:id="@+id/optFtpRename"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/drawer_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Remote Rename"
            android:textColor="#E0F7FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- OPTION 2: SYNC NOW -->

    <!-- OPTION 3: PERMANENT DOWNLOAD -->
    <LinearLayout
        android:id="@+id/optFtpDownload"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/drawer_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Download Permanently"
            android:textColor="#E0F7FF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- OPTION 4: REMOTE DELETE -->
    <LinearLayout
        android:id="@+id/optFtpDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/drawer_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="Remote Delete"
            android:textColor="#FF007F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CLOSE BUTTON -->
    <Button
        android:id="@+id/btnCloseFtpItemOptions"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/glass_input_bg"
        android:text="@string/cancel"
        android:textColor="#80C5DE"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>